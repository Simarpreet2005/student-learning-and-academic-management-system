# ==============================================================================
# Academic LMS — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Core Django Security Settings
# Generate a strong, unique secret key for production environments.
SECRET_KEY=set-a-random-secret-key-here

# Set DEBUG to False in production
DEBUG=True
ENVIRONMENT=development

# Comma-separated list of valid host/domain names
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Time Zone Configuration (IANA standard)
TIME_ZONE=UTC

# ==============================================================================
# Database Configuration
# In development, leave blank to use the default SQLite database.
# In production, provide either DATABASE_URL or individual DB_* parameters.
# ==============================================================================
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/academic_lms
DB_NAME=academic_lms
DB_USER=academic_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Email Configuration
# In development, emails are written to the console by default.
# In production, configure standard SMTP credentials.
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Academic LMS <noreply@academiclms.local>"

# ==============================================================================
# Production Security & SSL (Leave False for local development)
# ==============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
